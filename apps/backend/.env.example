PORT=8000
NODE_ENV=development

# --- Security ---
# Generate with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
# The server refuses to start when this is unset or literally 'change_this'.
JWT_SECRET=
# Access-token lifetime in minutes (also used for the cookie max-age).
# Keep short (60); sessions renew silently via the refresh cookie.
JWT_EXPIRE_MINUTES=60

# --- Database ---
# Local dev: leave DATABASE_URL unset and the app uses a SQLite file
# instead (see DATABASE_STORAGE below).
# Production: set DATABASE_URL to a managed Postgres connection string,
# e.g. from Neon, Supabase, Railway, Render Postgres, or AWS RDS. Once set,
# the app switches to Postgres automatically (see src/config/database.js).
# DATABASE_URL=postgresql://user:password@host:5432/dbname
DATABASE_STORAGE=campus.db
# Most managed Postgres providers require SSL; leave this unset/true unless
# you're connecting to a Postgres instance that explicitly does not use SSL.
# DATABASE_SSL=true
# TLS certificates are validated by default. Providers with custom CAs:
# set DATABASE_SSL_CA to the CA PEM (contents or a file path), or — only for
# self-signed setups — DATABASE_SSL_REJECT_UNAUTHORIZED=false.
# DATABASE_SSL_REJECT_UNAUTHORIZED=false
# DATABASE_SSL_CA=

# --- CORS ---
# Comma-separated list of frontend origins allowed to call this API.
CORS_ORIGINS=http://localhost:5173

# --- Email (Brevo primary, Resend fallback, SMTP last resort) ---
# Without any provider configured, dev simulates emails to the console and
# production email sending fails.
# BREVO_API_KEY=
# RESEND_API_KEY=
# EMAIL_FROM=Sangam Platform <noreply@yourdomain.edu.in>
# Legacy SMTP fallback (also used if GMAIL_USER/GMAIL_PASS are set):
# SMTP_HOST=
# SMTP_PORT=587
# SMTP_USER=
# SMTP_PASS=

# --- Google OAuth ("Continue with Google") ---
# Required in production — Google sign-in fails closed without it.
# This app uses Google Identity Services (a client-side sign-in button that
# returns a signed ID token) - not a server-side OAuth redirect - so only an
# "Authorized JavaScript origin" is needed in Google Cloud Console, not a
# redirect/callback URI.
# Create an OAuth 2.0 Client ID (Web application) in Google Cloud Console,
# add http://localhost:5173 (dev) and your production frontend URL as
# authorized JavaScript origins, and paste the client ID below. The same
# value must also be set as VITE_GOOGLE_CLIENT_ID in the frontend env.
GOOGLE_CLIENT_ID=your-google-oauth-client-id.apps.googleusercontent.com

# --- Logging ---
# LOG_LEVEL=info
