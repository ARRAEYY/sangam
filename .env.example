# Backend Variables
PORT=8000
NODE_ENV=development
DATABASE_URL=postgres://user:password@localhost:5432/sangam
JWT_SECRET=your_jwt_secret_key

# Frontend Variables
VITE_API_URL=http://localhost:8000/api

# --- Platform administration (#57) ---
# Comma-separated campus email addresses that hold platform-admin powers
# (user listing, account suspension). No self-service promotion exists.
# PLATFORM_ADMINS=admin1@rishihood.edu.in,admin2@rishihood.edu.in

# --- Error monitoring (#61) ---
# Production-only webhook (Slack/Discord/custom ingest) that receives a JSON
# report for every 5xx and process-level failure. No-op when unset or when
# NODE_ENV is not production.
# ERROR_WEBHOOK_URL=https://hooks.example.com/your-endpoint
# Max time to wait for in-flight requests and DB work on SIGTERM/SIGINT
# before force-exiting.
# SHUTDOWN_TIMEOUT_MS=15000
